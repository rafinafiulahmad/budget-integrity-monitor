# ============================================================
#  Budget Integrity Monitor — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ============================================================

# ── Anthropic API (required) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── SMTP — for password reset & invite emails (required) ────
BIM_SMTP_HOST=smtp.gmail.com
BIM_SMTP_PORT=587
BIM_SMTP_USER=your@gmail.com
BIM_SMTP_PASS=your-app-password
BIM_SMTP_FROM=monitor@yourorg.org

# ── App base URL (required for invite links) ─────────────────
BIM_BASE_URL=http://localhost:5000
BIM_SECRET_KEY=change-this-to-a-long-random-secret

# ── Google SSO — optional, skip if not using ─────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Restrict sign-in to specific Google Workspace domains (comma-separated)
# Leave empty to allow all Google accounts
GOOGLE_ALLOWED_DOMAINS=yourorg.org
